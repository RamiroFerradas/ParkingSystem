{
  "name": "parking-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env.local --test \"tests/db/*.test.mjs\"",
    "test:db": "node --env-file-if-exists=.env.local --test \"tests/db/*.test.mjs\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run && node --env-file-if-exists=.env.local --test \"tests/db/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "e2e:schema": "node e2e/support/schema.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-table": "^8.21.3",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
